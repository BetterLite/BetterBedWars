{
  "name": "betterlite/betterbedwars",
  "description": "BedWars for PocketMine-MP",
  "type": "pocketmine-plugin",
  "license": "LGPL-3.0",
  "require": {
    "bstats/pocketmine-mp": "^1.0",
    "betterlite/pocketmine-mp": "^5.50.0",
    "dresnite/easyui": "^1.0.6"
  },
  "require-dev": {
    "sof3/pharynx": "^0.3.0"
  },
  "autoload": {
    "classmap": ["src"]
  },
  "scripts": {
    "build": [
      "@php build/create-vendor-stub.php",
      "php -dphar.readonly=0 vendor/bin/pharynx -i=. -c -p=BetterBedWars.phar"
    ],
    "post-install-cmd": "@php build/create-vendor-stub.php",
    "post-update-cmd": "@php build/create-vendor-stub.php"
  },
  "config": {
    "platform": {
      "php": "8.1.0"
    },
    "sort-packages": true
  }
}